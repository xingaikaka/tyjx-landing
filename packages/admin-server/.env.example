# 复制为 .env 用于本地开发,服务器同名放在 packages/admin-server/.env
# 千万不要提交 .env 到 Git

# 服务端口
PORT=3010

# 数据 / 文件存储
DB_PATH=src/data/portal.db
UPLOAD_DIR=src/data/uploads

# 认证
JWT_SECRET=please-replace-with-32-bytes-random-string
JWT_EXPIRES_IN=7d

# 默认管理员(初始化数据库时创建)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=please-change-on-first-login

# Worker ↔ admin-server 通信加密(必须跟 Worker 的 PORTAL_API_SECRET 一致)
PORTAL_API_SECRET=please-replace-with-32-bytes-random-string

# 媒体资源 AES-256-GCM key(必须 64 个 hex 字符 = 32 字节 256-bit)
# 后台上传图片/poster 时用此 key 加密上 R2,落地页/admin 拉密文用 Web Crypto 解密
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 没配会启动时打印随机临时 key,重启就丢,生产必须显式配
ASSET_AES_KEY=please-replace-with-64-hex-chars

# /api/portal/* 响应加密 key(AES-256-CBC,64 hex)。包成 {"e":"<base64>"} 形式。
# 必须与 luodiye_video 的 NEXT_PUBLIC_PORTAL_API_AES_KEY 同值,否则浏览器解密失败。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_API_AES_KEY=please-replace-with-64-hex-chars

# ─────────── 媒体存储后端 ───────────
# local = 写本机 UPLOAD_DIR,nginx /uploads/ 反代 admin-server(默认)
# r2    = PUT 到 Cloudflare R2,对外 URL 走腾讯 CDN(回源 R2 公网域)
STORAGE_BACKEND=local

# (local 后端用)媒体对外访问的 base URL,拼到 url 前缀
PUBLIC_URL=http://localhost:3010
# 生产 local: https://admin-portal.example.com

# ─────────── R2 配置 (STORAGE_BACKEND=r2 时必填) ───────────
# 与 tyapp.app(dp/tyjx-admin) 共用同一个 R2 桶 + 同一个腾讯 EdgeOne CDN 域,
# 通过 STORAGE_KEY_PREFIX 区分目录,互不影响。
#
# R2 S3 兼容端点(从 Cloudflare R2 → API → "S3 客户端的端点" 拷贝)
# 形如 https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=luodiye
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 全局 key 前缀(避免和 dp 的 encrypted-assets/、downloads/、video-assets/ 冲突)
# 推荐 r2 模式下设为 'tyjx';留空 = 不加前缀(local 模式可不设)
STORAGE_KEY_PREFIX=tyjx

# 对外访问 base(腾讯 EdgeOne CDN 加速域,与 tyapp.app 共用)
# tyjx.app 独立 CDN(与 tyapp.app 的 cdn.calculus.xin 区分,但同一腾讯账号同一桶,
# 通过 STORAGE_KEY_PREFIX=tyjx 隔离目录)
# 该域在 EdgeOne 配置:回源域 = R2 自定义域 / r2.dev
CDN_BASE=https://tyjx.calculus.xin

# (可选)R2 公网域,仅当 CDN_BASE 未配置时用作 fallback
# 一般生产不要让前端直接拿到这个域,只给 CDN 回源用
# 默认沿用 dp 的 R2 dev 域
R2_PUBLIC_BASE=https://pub-388a2bdee6d148dda9bd7ae0b8fe7d79.r2.dev

# 跨域允许的 origin(luodiye_video 落地页所在域)
# 多个用逗号分隔,精确域名(支持通配符 *.tyjxhotpzixm.cc)
ALLOWED_ORIGINS=http://localhost:3008,*

# 限频(管理 API 单 IP 每分钟最多请求数,公开 API 不限)
ADMIN_RATE_LIMIT=60

# 单文件上传上限(MB)
MAX_UPLOAD_MB=200

# APK 上传上限(MB,默认 500;大于此值会被拒绝)
MAX_APK_MB=500

# ─────────── 腾讯云 CDN 缓存刷新 ───────────
# APK 上传成功后会自动调 PurgeUrlsCache 刷新 CDN_BASE 上的对应 URL,
# 这样固定下载地址(downloads/<slug>.bin)拿到的永远是最新版。
# 国内日免费 10000 次,日常用足够。
# 创建子用户密钥:腾讯云控制台 → 访问管理 CAM → 用户 → 子用户 → API 密钥
# 仅需勾选 "QcloudCDNFullAccess" 或 "QcloudCDNContentRefreshFullAccess"。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 可留空,默认 cdn.tencentcloudapi.com
# TENCENT_CDN_ENDPOINT=cdn.tencentcloudapi.com
