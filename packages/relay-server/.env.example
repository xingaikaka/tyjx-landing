# ─── tyjx-portal-server(原 @tyjx/relay-server)环境变量 ───
#
# 角色:tyjx.app 体系的中转层(品牌门户 / 入口页 / 发布页 SSR)。
# 链路:cdn666 → VPS Nginx(:80)→ 本服务(:3020)→ SSR HTML / 302
#
# 上线对应 admin:
#   PM2  : tyjxapp-admin
#   cwd  : /opt/tyjxapp/packages/admin-server/
#   port : 3010
#   接口 : /api/portal/runtime(iv:cipher 文本 AES-CBC)

# ─── 监听 ───
PORT=3020
HOST=127.0.0.1                     # 仅本机,Nginx 反代

# ─── 上游 admin ───
# 同机部署 → 走 127.0.0.1 不出网
ADMIN_BASE_URL=http://127.0.0.1:3010
# 必须与 /opt/tyjxapp/packages/admin-server/.env 的 PORTAL_API_SECRET 完全一致
# 部署脚本会从那里同步过来,不要在这里手填(留空即报错并打印提示)
PORTAL_API_SECRET=

# ─── 运行时配置缓存 ───
RUNTIME_CACHE_TTL=30               # 内存命中"新鲜"秒数
RUNTIME_CACHE_DIR=./.cache         # 本地文件兜底目录
ADMIN_FETCH_TIMEOUT_MS=4000        # 拉 admin 的硬超时(ms),要 < cdn666 回源超时

# ─── 兜底域池(可选)───
# admin 完全挂掉 + 本地无缓存时启用,正常运行不会用到
# FALLBACK_POOL={"brandDomains":["tyjx.app"],"entryPages":[],"publishPages":[],"finalLandings":[]}

# ─── 调试入口 ───
# 设置后可访问:
#   GET /api/_debug?token=xxx     看缓存状态 + 池规模
#   GET /api/_reload?token=xxx    强制刷新 admin
RUNTIME_PROBE_TOKEN=tyjxportal-probe-2026

# ─── 运行模式 ───
NODE_ENV=production
