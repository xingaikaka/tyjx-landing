# 仅 next dev 时生效(next dev 会自动读)。
# 生产 (`next build && next export`) 走 .env.production / 默认相对路径,
# nginx 把 /api/portal 反代到 admin-server。
#
# dev 时 admin-server 在 :3010,落地页 :3008,跨端口请求需要绝对 URL。
# admin host 由 NEXT_PUBLIC_ADMIN_BASE 注入,所有 /api/portal/* 端点都拼这个前缀。
#
# 媒体 URL(logo / poster / m3u8 内 ts)host 由后台 mediaCdnBase 配置决定,
# dev 建议在后台填 R2 公网域(https://pub-xxxxx.r2.dev),避免依赖 tyjx.calculus.xin DNS。
NEXT_PUBLIC_ADMIN_BASE=http://localhost:3010

# admin-server PORTAL_API_AES_KEY 同值(64 hex),用于解密 /api/portal/* 响应
NEXT_PUBLIC_PORTAL_API_AES_KEY=da42a447d4f67b1bb1f33d013418a5b1d3dca09f0af95dccac35683b3eadef6a
