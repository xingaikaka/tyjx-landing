# 拷贝到 ~/.apk-upload.env(推荐,跨项目复用)
# 然后  chmod 600 ~/.apk-upload.env  防止他人读取
#
# 优先级:--config <file>  >  $APK_UPLOAD_CONFIG  >  ~/.apk-upload.env

# ─── Cloudflare R2 (luodiye 桶) ────────────────────────
R2_ACCOUNT_ID=74dcb623526e1925a35e0991a0940f16
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=luodiye

# ─── 腾讯云 EdgeOne (calculus.xin zone) ────────────────
